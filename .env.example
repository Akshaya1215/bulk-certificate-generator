# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="Bulk Certificate Generator"
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/certificates_db

# Redis & Celery Configuration
# Format: redis://<host>:<port>/<db_index>
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Set to true for synchronous Celery task execution (useful in tests or single-node development)
CELERY_TASK_ALWAYS_EAGER=false

# Local Storage Configuration
STORAGE_PATH=generated

# Bulk Job Limits
MAX_BATCH_SIZE=1000
